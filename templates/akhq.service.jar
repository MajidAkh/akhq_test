[Unit]
Description=AKHQ Kafka Management UI

[Service]
WorkingDirectory={{ akhq_install_dir }}
ExecStart=/usr/bin/java -Dmicronaut.config.files=/etc/akhq/akhq.yml -jar {{ akhq_install_dir }}/akhq.jar
Type=simple
Restart=on-failure
RestartSec=10
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
